[Unit]
Description=TAPAS Growth Autopilot backend (FastAPI, 127.0.0.1:8000)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Adjust User/WorkingDirectory/ExecStart to your checkout. The reference
# deployment runs the launcher (which injects vault-held credentials into
# the child environment); a plain checkout can run uvicorn directly and
# rely on the checkout's .env instead.
WorkingDirectory=/home/hatch/workspace/tapas-social-backend-original
ExecStart=/usr/bin/python3 /home/hatch/workspace/tapas-growth-launcher.py
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=20
# Optional root-only env file (mode 600) for egress-proxy variables in
# restricted networks. Never commit this file.
EnvironmentFile=-/etc/tapas-backend/proxy.env
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tapas-growth-backend

[Install]
WantedBy=multi-user.target
