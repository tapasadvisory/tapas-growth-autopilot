TAPAS_BASE_URL=
TAPAS_FRONTEND_ORIGIN=
TAPAS_DATA_DIR=
DISCOVERY_INTERVAL_MINUTES=60
ANALYTICS_AUTO_SYNC_ENABLED=false
ANALYTICS_SYNC_INTERVAL_MINUTES=15
TOKEN_ENCRYPTION_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=
LINKEDIN_EXTRA_SCOPES=
LINKEDIN_ORGANIZATION_URN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
X_CLIENT_ID=
X_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
BLUESKY_HANDLE=
MASTODON_INSTANCE=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Optional: public GitHub repository statistics need no token; traffic metrics require a token with push access.
GITHUB_TOKEN=

# Optional signed post-published event webhook (distribution/analytics only; no engagement pods)
PUBLICATION_EVENTS_ENABLED=false
PUBLICATION_EVENTS_WEBHOOK_URL=
PUBLICATION_EVENTS_WEBHOOK_SECRET=

# v1.7 owned-channel publishing (Threads / Instagram / YouTube adapters;
# publishing scopes are opt-in via the EXTRA_SCOPES variables and are only
# requested at re-consent; readiness stays blocked until scopes are granted)
THREADS_APP_ID=
THREADS_APP_SECRET=
GOOGLE_EXTRA_SCOPES=
META_EXTRA_SCOPES=
X_EXTRA_SCOPES=
INSTAGRAM_GRAPH_VERSION=
TAPAS_MEDIA_HOSTS=
TAPAS_MEDIA_ROOT=
TAPAS_MAX_UPLOAD_BYTES=
TAPAS_IG_POLL_TIMEOUT_SECONDS=
TAPAS_IG_POLL_INTERVAL_SECONDS=

# --- Meta Integration Hub (v1.8) ---
# Facebook Page publishing + insights use the SAME Meta app as Instagram
# (META_APP_ID / META_APP_SECRET). The connect flow resolves this Page,
# verifies the permissions Meta granted, and stores the Page access token.
FACEBOOK_PAGE_ID=61595126285733
# Page scopes requested at connect: pages_show_list, pages_manage_posts,
# pages_read_engagement, read_insights (+ anything in META_EXTRA_SCOPES).
