# Optional signed post-published event webhook (distribution/analytics only; no engagement pods)
PUBLICATION_EVENTS_ENABLED=false
PUBLICATION_EVENTS_WEBHOOK_URL=
PUBLICATION_EVENTS_WEBHOOK_SECRET=

# v1.6 external provider integrations (store secrets only in backend .env)
CONNECTSAFELY_API_KEY=
MAGICPOST_API_KEY=
MAGICPOST_WORKSPACE_ID=
SUPERGROW_API_KEY=
SUPERGROW_WORKSPACE_ID=
VIDIQ_API_KEY=
TUBEBUDDY_API_KEY=

# YouTube target is a goal, not a guaranteed outcome
YOUTUBE_VIEW_TARGET=5000
YOUTUBE_UPLOAD_PRIVACY_STATUS=private

# v1.6 Engagement Intelligence webhook (human-review notifications only)
ENGAGEMENT_INTELLIGENCE_ENABLED=false
ENGAGEMENT_INTELLIGENCE_WEBHOOK_URL=
ENGAGEMENT_INTELLIGENCE_WEBHOOK_SECRET=

# v1.7 owned-channel publishing (Threads / Instagram / YouTube adapters;
# publishing scopes are opt-in via the EXTRA_SCOPES variables and are only
# requested at re-consent; readiness stays blocked until scopes are granted)
THREADS_APP_ID=
THREADS_APP_SECRET=
GOOGLE_EXTRA_SCOPES=
META_EXTRA_SCOPES=
X_EXTRA_SCOPES=
